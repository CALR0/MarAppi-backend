## Copy to `.env` and edit values for local development.
# Do NOT commit your real .env with secrets to version control.

# Flask settings
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=1

# Security
SECRET_KEY=change-me-to-a-secure-value

# Database: by default this uses the local SQLite file in `instance/`
# For Postgres (example): postgres://user:pass@localhost:5432/marappidb
DATABASE_URL=sqlite:///instance/marappi.db
